@@ -117,0 +118,18 @@ MSLaneChangerSublane::change() {
+    double remotePhaseBSpeedLat = 0.;
+    if (vehicle->hasInfluencer()
+            && vehicle->getInfluencer().consumeRemoteLaneChangeSpeedRestore(
+                remotePhaseBSpeedLat)
+            && std::isfinite(remotePhaseBSpeedLat)) {
+        MSAbstractLaneChangeModel& laneChangeModel =
+            vehicle->getLaneChangeModel();
+        const double remainingManeuver = laneChangeModel.getManeuverDist();
+        const double maxRemainingSpeedLat = DIST2SPEED(remainingManeuver);
+        const bool restoreContinuesManeuver =
+            remotePhaseBSpeedLat * remainingManeuver > 0.;
+        const double boundedSpeedLat =
+            !restoreContinuesManeuver
+            ? 0.
+            : fabs(remotePhaseBSpeedLat) <= fabs(maxRemainingSpeedLat)
+              ? remotePhaseBSpeedLat : maxRemainingSpeedLat;
+        laneChangeModel.setSpeedLat(boundedSpeedLat);
+    }
@@ -125,0 +144,37 @@ MSLaneChangerSublane::change() {
+    double remoteRebaseTargetPosLat = 0.;
+    const int remoteRebaseDirection = vehicle->hasInfluencer()
+                                      ? vehicle->getInfluencer().consumeRemoteLaneChangeRebase(
+                                            remoteRebaseTargetPosLat)
+                                      : 0;
+    if (remoteRebaseDirection != 0 && mayChange(remoteRebaseDirection)) {
+        ChangerIt to = myCandi + remoteRebaseDirection;
+        const bool remoteRebaseTraCI =
+            (vehicle->getLaneChangeModel().getOwnState() & LCA_TRACI) != 0;
+        if (checkChangeToNewLane(
+                vehicle, remoteRebaseDirection, myCandi, to)) {
+            MSAbstractLaneChangeModel& laneChangeModel =
+                vehicle->getLaneChangeModel();
+            const double currentPosLat = vehicle->getLateralPositionOnLane();
+            const double correction = remoteRebaseTargetPosLat - currentPosLat;
+            if (std::isfinite(correction)) {
+                vehicle->setLateralPositionOnLane(currentPosLat + correction);
+                vehicle->invalidateCachedPosition();
+                for (double& furtherPosLat : vehicle->myFurtherLanesPosLat) {
+                    furtherPosLat += correction;
+                }
+                laneChangeModel.updateSafeLatDist(correction);
+            }
+            const double rebasedManeuverDist = -remoteRebaseTargetPosLat;
+            laneChangeModel.setManeuverDist(rebasedManeuverDist);
+            if (remoteRebaseTraCI) {
+                vehicle->getInfluencer().setSublaneChange(
+                    rebasedManeuverDist);
+            }
+            laneChangeModel.updateShadowLane();
+            laneChangeModel.updateTargetLane();
+            vehicle->getInfluencer().invalidateRemoteControlHistory();
+            myCandi->lane->requireCollisionCheck();
+            to->lane->requireCollisionCheck();
+            return true;
+        }
+    }
