@@ -1493,0 +1494,17 @@ class VehicleDomain(VTypeDomain):
+    @alias_param("laneIndex", "lane")
+    def moveToXYImmediate(self, vehID, edgeID, laneIndex, x, y,
+                          angle=tc.INVALID_DOUBLE_VALUE, keepRoute=1,
+                          matchThreshold=100, strictLaneHint=False):
+        '''Immediately apply a moveToXY position and angle without advancing
+        simulation time. The resulting pose is used as the initial state of
+        the next simulationStep.
+        strictLaneHint constrains matching to the supplied primary lane and
+        fails if that lane is not the vehicle's current route lane.
+        '''
+        if strictLaneHint:
+            self._setCmd(tc.MOVE_TO_XY_IMMEDIATE, vehID, "tsidddbdb", 8, edgeID, laneIndex,
+                         x, y, angle, keepRoute, matchThreshold, True)
+        else:
+            self._setCmd(tc.MOVE_TO_XY_IMMEDIATE, vehID, "tsidddbd", 7, edgeID, laneIndex,
+                         x, y, angle, keepRoute, matchThreshold)
+
